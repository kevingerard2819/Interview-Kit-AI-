# Server Port
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# MongoDB URI (Optional: If left empty or unreachable, the server and evaluate CLI automatically fall back to an in-memory database)
MONGODB_URI=mongodb://localhost:27017/interview_prep_kit

# JWT Secret for user session tokens
JWT_SECRET=trao-assessment-secure-jwt-secret-key-32chars

# LLM Configuration (Google Gemini / OpenAI / Groq compatible)
# Gemini API Key (Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Optional: Set to 'offline-mock' or 'mock' for local offline testing/CI without external API credits
LLM_PROVIDER=gemini

# Node Environment
NODE_ENV=development
